{
  "name": "needless-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Needless UI: the Needlessly Engineered Styling Toolkit.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "dev": "pnpm build:tokens && pnpm build:core && pnpm docs:generate && ng serve docs",
    "build": "pnpm build:tokens && pnpm build:css && pnpm build:core && pnpm build:angular && pnpm build:react",
    "build:tokens": "pnpm --filter @needless-ui/tokens run build",
    "build:css": "pnpm --filter @needless-ui/css run build",
    "build:core": "pnpm --filter @needless-ui/core run build",
    "build:angular": "ng build @needless-ui/angular && node packages/angular/schematics/build.ts",
    "build:react": "pnpm --filter @needless-ui/react run build",
    "test": "pnpm build:core && pnpm --filter @needless-ui/tokens --filter @needless-ui/css run test && pnpm test:schematics && ng test @needless-ui/angular --watch=false && pnpm --filter @needless-ui/react run test && pnpm docs:generate && ng test docs --watch=false",
    "test:schematics": "node --test packages/angular/schematics/*/*.test.ts",
    "typecheck": "pnpm build:core && pnpm --filter @needless-ui/tokens --filter @needless-ui/css --filter @needless-ui/core --filter @needless-ui/react run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "docs:generate": "node apps/docs/scripts/generate-code.ts",
    "build:docs": "pnpm build:tokens && pnpm build:core && pnpm docs:generate && ng build docs && node apps/docs/scripts/seo-check.ts && node apps/docs/scripts/paint-first.ts && node apps/docs/scripts/trim-css.ts && node apps/docs/scripts/llms.ts",
    "check:browsers": "node apps/docs/scripts/browser-check.ts"
  },
  "dependencies": {
    "@angular/aria": "^22.2.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "matter-js": "0.20.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.4",
    "@angular-devkit/schematics": "^22.2.4",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@needless-ui/core": "workspace:*",
    "@needless-ui/css": "workspace:*",
    "@needless-ui/tokens": "workspace:*",
    "@schematics/angular": "^22.2.2",
    "@shikijs/transformers": "4.5.0",
    "@types/matter-js": "0.20.2",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.5",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "shiki": "4.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
