{
  "name": "@needless-ui/tokens",
  "version": "0.6.0",
  "description": "Design tokens for Needless UI in W3C DTCG format, compiled to CSS custom properties.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/needless-ui/needless-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/needless-ui/needless-ui/tree/main/packages/tokens#readme",
  "bugs": "https://github.com/needless-ui/needless-ui/issues",
  "keywords": [
    "design-tokens",
    "dtcg",
    "css-variables",
    "theming",
    "needless-ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "style": "./dist/tokens.css",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "palette": "node scripts/palette.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
