{
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation for floating surfaces. The color comes from each mode, so shadows stay visible on dark canvases.",
    "sm": {
      "$value": {
        "color": "{color.shadow}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "md": {
      "$value": [
        {
          "color": "{color.shadow}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 8, "unit": "px" },
          "blur": { "value": 24, "unit": "px" },
          "spread": { "value": -6, "unit": "px" }
        },
        {
          "color": "{color.shadow}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 3, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": "{color.shadow}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 24, "unit": "px" },
          "blur": { "value": 48, "unit": "px" },
          "spread": { "value": -12, "unit": "px" }
        },
        {
          "color": "{color.shadow}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 6, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    }
  }
}
