{
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale on a 4px grid.",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "5": { "$value": { "value": 1.25, "unit": "rem" } },
    "6": { "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$value": { "value": 2, "unit": "rem" } },
    "10": { "$value": { "value": 2.5, "unit": "rem" } },
    "12": { "$value": { "value": 3, "unit": "rem" } },
    "16": { "$value": { "value": 4, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "sm": { "$value": { "value": 0.25, "unit": "rem" } },
    "md": { "$value": { "value": 0.375, "unit": "rem" } },
    "lg": { "$value": { "value": 0.5, "unit": "rem" } },
    "xl": { "$value": { "value": 0.75, "unit": "rem" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 2, "unit": "px" } }
  },
  "control-height": {
    "$type": "dimension",
    "$description": "Heights for buttons and inputs. The smallest still clears the WCAG 2.2 24×24px target minimum.",
    "sm": { "$value": { "value": 1.75, "unit": "rem" } },
    "md": { "$value": { "value": 2.25, "unit": "rem" } },
    "lg": { "$value": { "value": 2.75, "unit": "rem" } }
  },
  "focus-ring": {
    "$type": "dimension",
    "width": { "$value": { "value": 2, "unit": "px" } },
    "offset": { "$value": { "value": 2, "unit": "px" } }
  },
  "radius-scale": {
    "$type": "number",
    "$value": 1,
    "$description": "Multiplies every component radius. data-nui-radius sets it for a subtree: 0 (none), 0.5 (small), 2 (large) or 999 (full)."
  },
  "density": {
    "$type": "number",
    "$value": 1,
    "$description": "Multiplies control heights, paddings and gaps. data-nui-density sets it for a subtree: 0.8 (compact) or 1.25 (roomy). Controls never shrink below the 24px target minimum."
  }
}
